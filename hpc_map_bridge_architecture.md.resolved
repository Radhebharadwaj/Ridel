## Phase 2: Off-Main-Thread Routing (Web Workers)

### Current Flow
```
Main Thread: HTTP fetch → compute(isolate) → deserialize → build GeoJSON → bridge call
```

### Proposed Flow
```
Main Thread: postMessage(origin, dest, apiKey)  →  [Web Worker does ALL of this]  →  postMessage(routeResult)
                                                          ↓
                                          fetch() → parse → simplify → buffer
```

### Web Worker Implementation

```javascript
// File: web/js/ridel_route_worker.js

self.onmessage = async function(e) {
  const { origin, destination, mode, apiKey, waypoints, requestId } = e.data;
  
  try {
    let url = `https://api.olamaps.io/routing/v1/directions?origin=${origin.lat},${origin.lng}&destination=${destination.lat},${destination.lng}&api_key=${apiKey}&mode=${mode}&alternatives=true&steps=true&traffic_metadata=true&overview=full`;
    
    if (waypoints && waypoints.length > 0) {
      url += `&waypoints=${waypoints.map(w => `${w.lat},${w.lng}`).join('|')}`;
    }
    
    const response = await fetch(url, { 
      method: 'POST',
      headers: { 'Accept': 'application/json' }
    });
    
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    
    const data = await response.json();
    if (!data.routes || data.routes.length === 0) throw new Error('No routes');
    
    // Parse all routes
    const allRoutes = [];
    const allDurations = [];
    const steps = [];
    let distanceKm = 0;
    let durationMins = 0;
    let firstInstruction = 'Head to destination';
    let congestion = null;
    
    for (let i = 0; i < data.routes.length; i++) {
      const route = data.routes[i];
      const leg = route.legs?.[0];
      if (!leg) continue;
      
      // Decode polyline (Ola uses Google format)
      let polyline = '';
      if (typeof route.overview_polyline === 'string') polyline = route.overview_polyline;
      else if (route.overview_polyline?.points) polyline = route.overview_polyline.points;
      else if (typeof route.geometry === 'string') polyline = route.geometry;
      
      const coords = decodePolyline(polyline);
      const simplified = douglasPeucker(coords, 0.0001);
      allRoutes.push(simplified);
      allDurations.push(leg.duration || 0);
      
      if (i === 0) {
        distanceKm = (leg.distance || 0) / 1000;
        durationMins = Math.ceil((leg.duration || 0) / 60);
        
        const rawSteps = leg.steps || [];
        if (rawSteps.length > 0 && rawSteps[0].html_instructions) {
          firstInstruction = rawSteps[0].html_instructions.replace(/<[^>]*>/g, '');
        }
        
        // Extract congestion
        congestion = extractCongestion(rawSteps);
      }
    }
    
    // Convert primary route to transferable Float64Array
    const primaryBuffer = new Float64Array(allRoutes[0].length * 2);
    for (let i = 0; i < allRoutes[0].length; i++) {
      primaryBuffer[i * 2] = allRoutes[0][i][0];     // lng
      primaryBuffer[i * 2 + 1] = allRoutes[0][i][1]; // lat
    }
    
    // Transfer the buffer (zero-copy to main thread)
    self.postMessage({
      requestId,
      success: true,
      primaryBuffer,
      primaryPointCount: allRoutes[0].length,
      altRoutes: allRoutes.slice(1), // Alt routes are small, JSON is fine
      allDurations,
      distanceKm,
      durationMins,
      firstInstruction,
      congestion,
    }, [primaryBuffer.buffer]); // Transferable!
    
  } catch (error) {
    self.postMessage({ requestId, success: false, error: error.message });
  }
};

// Standard Google polyline decoder
function decodePolyline(str) { /* ... standard implementation ... */ }

// Douglas-Peucker line simplification
function douglasPeucker(points, tolerance) { /* ... standard implementation ... */ }

// Extract congestion from steps
function extractCongestion(steps) { /* ... */ }
```

### Dart Integration

```dart
// File: lib/core/map/bridge/route_worker_bridge.dart

import 'dart:js_interop';
import 'package:web/web.dart' as web;

class RouteWorkerBridge {
  static web.Worker? _worker;
  static int _requestCounter = 0;
  static final Map<int, Completer<Map<String, dynamic>>> _pending = {};
  
  static void initialize() {
    _worker = web.Worker('js/ridel_route_worker.js'.toJS);
    _worker!.onmessage = ((web.MessageEvent event) {
      final data = (event.data as JSObject).dartify() as Map;
      final id = data['requestId'] as int;
      _pending.remove(id)?.complete(data as Map<String, dynamic>);
    }).toJS;
  }
  
  static Future<Map<String, dynamic>> calculateRoute({
    required double originLat, required double originLng,
    required double destLat, required double destLng,
    required String mode, required String apiKey,
    List<Map<String, double>>? waypoints,
  }) {
    final id = _requestCounter++;
    final completer = Completer<Map<String, dynamic>>();
    _pending[id] = completer;
    
    _worker!.postMessage({
      'requestId': id,
      'origin': {'lat': originLat, 'lng': originLng},
      'destination': {'lat': destLat, 'lng': destLng},
      'mode': mode,
      'apiKey': apiKey,
      'waypoints': waypoints,
    }.jsify());
    
    return completer.future.timeout(const Duration(seconds: 8));
  }
  
  static void dispose() {
    _worker?.terminate();
    _pending.clear();
  }
}
```

### Impact Analysis

| Metric | Before | After |
|--------|--------|-------|
| Main thread block during route parse | ~30ms (JSON decode + Douglas-Peucker) | **0ms** (worker) |
| Main thread block during GeoJSON build | ~15ms | **0ms** (worker builds buffer) |
| Bridge serialization cost | ~50ms (10 × JSON stringify/parse) | **~2ms** (1 × buffer transfer) |
| Total main thread cost per route | **~95ms** | **~2ms** |

> [!WARNING]
> **Web Worker fetch() and CORS**: The Ola Maps API must support CORS for Worker-initiated requests. Currently the Dart code uses `http.Client` which goes through the browser's fetch polyfill. Workers use native `fetch()` which requires the same CORS headers. **Verify this before implementation.**

